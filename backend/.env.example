# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS).
# Include your GitHub Pages URL and any custom domain.
CORS_ORIGIN=https://bhartendra4.github.io,http://localhost:3000

# ─── Database ─────────────────────────────────────────────
# PostgreSQL is preferred in production. Set DATABASE_URL and it is used automatically.
# Leave DATABASE_URL empty during development to fall back to SQLite.
DATABASE_URL=postgres://username:password@localhost:5432/kwg_franchise
# Used only when DATABASE_URL is empty (SQLite dev mode):
SQLITE_STORAGE=./database/franchise.sqlite

# ─── SMTP / Email (Nodemailer) ────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@pinkspoonfood.com
SMTP_PASS=your_smtp_password_here
MAIL_FROM="Kulche Wali Gali <contact@pinkspoonfood.com>"
MAIL_TO=contact@pinkspoonfood.com

# ─── Anti-spam ────────────────────────────────────────────
# Same email OR mobile within this many minutes is treated as a duplicate.
DUPLICATE_WINDOW_MINUTES=10
# Max submissions per IP per window (rate limiting).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15
